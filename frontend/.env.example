# Kong API Gateway URL for production builds.
# In dev (npm run dev) this is not needed — Vite proxies /api to Kong at localhost:8888.
# For production (npm run build), set this so the browser calls Kong directly.
# Example: VITE_KONG_URL=http://your-server:8888
VITE_KONG_URL=

# SSE dedicated port — HTTPS+HTTP/2 (dev only).
# Kong listens on port 8889 exclusively for SSE / streaming connections using
# HTTPS with a self-signed localhost cert (generated by setup.sh).
# HTTP/2 multiplexes all EventSource connections over a single TCP connection,
# removing the browser's 6-connection-per-origin limit so 10+ concurrent
# streams all open immediately instead of queuing.
# First-time setup: visit https://localhost:8889 once and accept the cert warning.
# Leave empty in production — SSE will follow VITE_KONG_URL automatically.
VITE_SSE_URL=https://localhost:8889
