# nginx-api URL.
#
# Proxy mode (default, leave empty):
#   Vite proxies /api/* to nginx-api :8443 (HTTPS/HTTP2).
#   Centrifugo WebSocket connections go directly to nginx-ui :22332.
#
# Direct mode (set to nginx-api HTTPS origin):
#   Browser talks straight to nginx-api — REST over HTTP/2 (absolute URL, no proxy
#   hop).  CORS is configured in nginx-api.conf for https://localhost:3000.
#   Use this mode to test concurrency without the Vite proxy bottleneck.
#
#   Example (dev direct): VITE_API_URL=https://localhost:8443
#   Example (prod build):  VITE_API_URL=https://localhost:8443
VITE_API_URL=
