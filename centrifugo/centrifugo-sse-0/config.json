{
  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis-sse-0:6379"
    }
  },
  "client": {
    "channel_limit": 1024,
    "allowed_origins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:3001",
      "https://localhost:3001",
      "http://localhost:3002",
      "https://localhost:3002",
      "http://localhost:3003",
      "https://localhost:3003",
      "http://localhost:22332",
      "https://localhost:22332",
      "http://localhost:8886",
      "https://localhost:8886",
      "http://localhost:8888",
      "https://localhost:8443",
      "http://127.0.0.1:3000",
      "https://127.0.0.1:3000",
      "http://127.0.0.1:3001",
      "https://127.0.0.1:3001",
      "http://127.0.0.1:3002",
      "https://127.0.0.1:3002",
      "http://127.0.0.1:3003",
      "https://127.0.0.1:3003",
      "http://127.0.0.1:22332",
      "https://127.0.0.1:22332",
      "http://127.0.0.1:8888",
      "https://127.0.0.1:8443"
    ]
  },
  "channel": {
    "namespaces": [
      {
        "name": "thread",
        "history_size": 2000,
        "history_ttl": "600s",
        "force_recovery": true
      }
    ]
  },
  "health": {
    "enabled": true
  },
  "log": {
    "level": "debug"
  }
}
