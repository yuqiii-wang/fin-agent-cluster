# ── LLM provider selection ──────────────────────────────────
LLM_PROVIDER=ark

# ── Volcano Engine ARK / Doubao ─────────────────────────────
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-mini-260215

# ── Google Gemini ───────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# ── Google Embedding ────────────────────────────────────────
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
GOOGLE_EMBEDDING_DIMENSIONS=768

# ── Local Ollama ────────────────────────────────────────────
OLLAMA_SERVER_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5-27b
OLLAMA_EMBED_MODEL=qwen3-0.6b-emb

# ── Database / API keys ─────────────────────────────────────
DATABASE_PG_URL=
DATABASE_PG_READ_URL=
DATABASE_REDIS_URL=redis://127.0.0.1:3456
DATABASE_REDIS_NODES=
DB_CONNECT_TIMEOUT_SECONDS=8
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
STATS_PROVIDER=mock

# ── FastAPI ──────────────────────────────────────────────────
FASTAPI_PORT=8432
RUNNER_INSTANCE_COUNT=4

# ── HTTP Proxy ──────────────────────────────────────────────
HTTP_PROXY=

# ── API Gateway ─────────────────────────────────────────
# Internal HTTP URL of nginx-api (no TLS, for container-internal calls).
API_GATEWAY_URL=http://127.0.0.1:8888

# ── Web search provider selection ────────────────────────────
WEB_SEARCH_PROVIDER=auto
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/news/search
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ── Volcano Engine web search ────────────────────────────────
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLC_SEARCH_HOST=open.volcengineapi.com
VOLC_SEARCH_REGION=cn-north-1
VOLC_SEARCH_SERVICE=search_platform

# ── Redis Streams (MQ / buffer layer) ────────────────────────
STREAM_MAX_LEN=1000000

# ── Centrifugo real-time messaging ───────────────────────────
CENTRIFUGO_NODES=["http://127.0.0.1:8101","http://127.0.0.1:8102"]
CENTRIFUGO_SSE_NODES=["http://127.0.0.1:8103","http://127.0.0.1:8104"]
CENTRIFUGO_SECRET=centrifugo-dev-secret-key
CENTRIFUGO_API_KEY=centrifugo-api-key
CENTRIFUGO_RPC_PROXY_KEY=centrifugo-rpc-proxy-key
CENTRIFUGO_PUBLIC_BASE=wss://localhost:22332


